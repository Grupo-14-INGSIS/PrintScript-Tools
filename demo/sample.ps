let greeting: string = "Hello, PrintScript!";
println(greeting);

let radius: number = 5;
const pi: number = 3.14159;
let area: number = pi * radius * radius;
println("Calculated area:");

println(area);

let isValid: boolean = true;
if (isValid) {
    let statusMessage: string = "Validation successful!";
    println(statusMessage);

} else {
    let errorMessage: string = "Validation failed!";
    println(errorMessage);

}